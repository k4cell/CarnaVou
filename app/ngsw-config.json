{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/logo/*.webp",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "mapa",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/mapa/*.mjs",
          "/mapa/*.css",
          "/mapa/*.json",
          "/mapa/letras/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "mapa-pedacos",
      "version": 1,
      "urls": [
        "/mapa/pedacos/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 300,
        "maxAge": "30d"
      }
    }
  ]
}
